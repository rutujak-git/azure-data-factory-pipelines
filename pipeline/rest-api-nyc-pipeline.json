{
	"name": "rest-api-nyc-pipeline",
	"properties": {
		"activities": [
			{
				"name": "for each rest api file",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.NYCResourceList",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "rest-api-toadls-copy",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_rest_nyc",
									"type": "DatasetReference",
									"parameters": {
										"RelativeURL": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_restapi_data",
									"type": "DatasetReference",
									"parameters": {
										"SinkFileName": {
											"value": "@replace(replace(item(), 'resource/', ''), '.json', '.json')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"NYCResourceList": {
				"type": "array",
				"defaultValue": [
					"resource/8meu-9t5y.json",
					"resource/43nn-pn8j.json",
					"resource/erm2-nwe9.json",
					"resource/mse5-qs8i.json"
				]
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-08-24T18:27:01Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}