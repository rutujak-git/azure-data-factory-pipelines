{
	"name": "pl_nyc_museums_orchestrator",
	"properties": {
		"activities": [
			{
				"name": "Copy REST API to Storage",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_rest_nyc_museums",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_restapi_data",
						"type": "DatasetReference",
						"parameters": {
							"SinkFileName": "nyc_museums.json"
						}
					}
				]
			},
			{
				"name": "Validate Raw File",
				"type": "Validation",
				"dependsOn": [
					{
						"activity": "Copy REST API to Storage",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_restapi_data",
						"type": "DatasetReference",
						"parameters": {
							"SinkFileName": "nyc_museums.json"
						}
					},
					"timeout": "00.00:02:00",
					"sleep": 10
				}
			},
			{
				"name": "Get File Metadata",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Validate Raw File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_restapi_data",
						"type": "DatasetReference",
						"parameters": {
							"SinkFileName": "nyc_museums.json"
						}
					},
					"fieldList": [
						"itemName",
						"size"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "Set Ingested File Variable",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get File Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_FileName",
					"value": {
						"value": "@activity('Get File Metadata').output.itemName",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Transform NYC Data",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Set Ingested File Variable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "nyc_file_two_cleaning",
						"type": "DataFlowReference",
						"datasetParameters": {
							"SourceFileTwo": {
								"SinkFileName": {
									"value": "@variables('v_FileName')",
									"type": "Expression"
								}
							},
							"sink": {
								"SinkTableName": "nyc_museums_cleaned.csv"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"variables": {
			"v_FileName": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-08-25T00:19:08Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}