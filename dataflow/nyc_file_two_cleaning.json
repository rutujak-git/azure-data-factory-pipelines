{
	"name": "nyc_file_two_cleaning",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_restapi_data",
						"type": "DatasetReference"
					},
					"name": "SourceFileTwo"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_adls",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "filter"
				},
				{
					"name": "flatten"
				}
			],
			"scriptLines": [
				"source(output(",
				"          boro as short,",
				"          city as string,",
				"          lat as double,",
				"          location as string,",
				"          location_lat_long as (coordinates as double[], type as string),",
				"          location_t as string,",
				"          long_ as double,",
				"          name as string,",
				"          objectid as short,",
				"          provider as string,",
				"          remarks as string,",
				"          sourceid as string,",
				"          ssid as string,",
				"          type as string,",
				"          x as double,",
				"          y as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> SourceFileTwo",
				"SourceFileTwo filter(!isNull(boro) && !isNull(city)) ~> filter",
				"filter foldDown(unroll(location_lat_long.coordinates, location_lat_long.coordinates),",
				"     mapColumn(",
				"          boro,",
				"          name,",
				"          city,",
				"          lat,",
				"          long = long_,",
				"          coordinates = location_lat_long.coordinates",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> flatten",
				"flatten sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['nyc_zones_cleaned.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink"
			]
		}
	}
}